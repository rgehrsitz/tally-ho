{
  "name": "tally-ho",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "svelte-kit sync && vitest run",
    "test:watch": "vitest",
    "start": "node build",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/database.ts migrate",
    "db:seed": "tsx --env-file-if-exists=.env scripts/database.ts seed",
    "test:integration": "svelte-kit sync && vitest run --config vitest.integration.config.ts",
    "db:local": "tsx scripts/local-postgres.ts"
  },
  "devDependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/creepster": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "embedded-postgres": "18.4.0-beta.17",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "qrcode": "^1.5.4"
  },
  "description": "Friendly party voting with individual and linked couple awards.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rgehrsitz/tally-ho.git"
  }
}
