# Local demo only. PIN auth and filesystem photos run only on the dev server.
APP_MODE=demo
DEMO_HOST_PIN=2468
# Optional local PostgreSQL; blank selects the single-process file demo.
# DATABASE_URL=postgresql://tally:local-demo-only@127.0.0.1:54329/tally_ho
DATABASE_URL=
EVENT_ID=halloween-demo

# Supabase mode (all values are SERVER-ONLY; never use a public/client prefix).
# APP_MODE=supabase
# DATABASE_URL=postgresql://.../postgres?sslmode=verify-full
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# New Supabase secret key or legacy service_role key. Never commit a real value.
SUPABASE_SECRET_KEY=
SUPABASE_PHOTO_BUCKET=costume-photos
